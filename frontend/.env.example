VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Set to 'true' to enable the dev-login user picker on the Signin page
# VITE_DEV_BYPASS=true

# Override which tenant this local frontend resolves to (normally derived
# from the subdomain, e.g. clc.bunklogs.net / tbe.bunklogs.net). Leave unset
# to keep the default Crane Lake (clc) look; set to another org's slug to
# test its branding locally, e.g.:
# VITE_DEV_ORGANIZATION_SLUG=tbe
#
# Requires restarting `vite dev` to take effect. To switch tenants without a
# restart, use the "org: ..." picker in the bottom-right corner of the app in
# dev mode instead -- it overrides this via localStorage and takes priority.

# Datadog RUM + Browser Logs + APM trace correlation (production by default)
# RUM and Logs SDKs must share clientToken/site/env/service/version for correlation.
# VITE_DATADOG_APPLICATION_ID=
# VITE_DATADOG_CLIENT_TOKEN=
# VITE_DATADOG_SITE=datadoghq.com
# VITE_DATADOG_ENV=prod  # must match backend DD_ENV
# VITE_DATADOG_SERVICE=bunklogs-frontend
# VITE_DATADOG_VERSION=1.0.0
# Set to 'true' to enable RUM + Logs locally (requires credentials above)
# VITE_DATADOG_FORCE_ENABLE=true
